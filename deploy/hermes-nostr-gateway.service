[Unit]
Description=Hermes Nostr Gateway (NIP-17 plane)
Documentation=https://github.com/nostr-protocol/nips
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Projects/hermes-nostr-gateway
Environment=HOME=/home/ubuntu
Environment=PYTHONPATH=/home/ubuntu/Projects/hermes-nostr-gateway/src
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# The identity key arrives as a systemd credential, not an Environment= line: systemd
# copies a root-owned file into $CREDENTIALS_DIRECTORY (a per-unit tmpfs, read-only to
# anyone but the unit's own user/group, removed when the unit stops), so the key is in
# neither `systemctl show` nor the process environment, and no child inherits it.
# config.yaml names it:
#     identity:
#       secret_credential: nostr_secret
# The source must exist before the first start, or the unit fails to start. Creating it
# is documented in docs/ops-notes.md, "Key handling".
LoadCredential=nostr_secret:/etc/hermes-nostr-gateway/identity.json
ExecStartPre=/usr/bin/install -d -m 0755 /home/ubuntu/.local/state/hermes-nostr-gateway/ngit-cache
ExecStart=/home/ubuntu/Projects/hermes-nostr-gateway/.venv/bin/hng serve
Restart=always
RestartSec=5
# The socket is 0600 and local-only, and the daemon refuses any connecting uid but its
# own (SO_PEERCRED); there is no network listener.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The state directory holds the store and the socket. The kanban boards are here too
# because the ngit watcher starts `hng ngit sync` as a child of this unit (see
# docs/ngit-bridge.md, "Waking the pass"), and a pass that cannot write a task would fail
# only when woken -- the cron pass, which runs outside the unit, would keep working.
#
# ngit needs two more writable places or every pass dies with "Read-only file system":
# its own cache (`NGIT_CACHE_DIR`; the default lives under ~/.cache, which ProtectHome
# covers) and the checkout's `.git`, because `ngit issue list` fetches before it lists.
# The rest of the checkout stays read-only on purpose -- the daemon has no business
# rewriting its own source.
Environment=NGIT_CACHE_DIR=/home/ubuntu/.local/state/hermes-nostr-gateway/ngit-cache
ReadWritePaths=/home/ubuntu/.local/state/hermes-nostr-gateway
ReadWritePaths=/home/ubuntu/.hermes/kanban
ReadWritePaths=/home/ubuntu/Projects/hermes-nostr-gateway/.git
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
